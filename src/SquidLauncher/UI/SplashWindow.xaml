<Window x:Class="SquidLauncher.UI.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SquidLauncher" Width="300" Height="311"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True" Background="Transparent"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Style="{x:Null}">
    <!--
        窗口是完全透明的（AllowsTransparency + Background=Transparent），屏幕上只有 GIF 本身，
        没有底色也没有边框。AllowsTransparency 会强制走分层窗口，所以窗口尺寸必须刚好包住图像，
        否则透明区仍然占着鼠标。

        这个窗口跑在独立 UI 线程上（见 UI/Splash.cs），因此**不能**用 DynamicResource：
        那些资源挂在 Application.Current.Resources 上、属于主窗口线程，跨线程访问会抛异常。
        Style="{x:Null}" 同理：显式置空可以让 WPF 跳过「去 Application.Resources 里找隐式样式」。
    -->
    <Image x:Name="Anim" Width="300" Height="311" Stretch="Uniform"
           Style="{x:Null}"
           RenderOptions.BitmapScalingMode="HighQuality"
           HorizontalAlignment="Center" VerticalAlignment="Center"/>
</Window>
