<UserControl x:Class="SquidLauncher.UI.Pages.ContentSearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:SquidLauncher.UI">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisInstalled"/>
    </UserControl.Resources>
    <DockPanel Margin="22,18,22,10">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock x:Name="Header" Text="Mod" Style="{StaticResource H1}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <RadioButton x:Name="SrcModrinth" GroupName="src" Style="{StaticResource Pill}" Content="Modrinth" Margin="0,0,6,0" Checked="Source_Checked"/>
                <RadioButton x:Name="SrcCurse" GroupName="src" Style="{StaticResource Pill}" Content="CurseForge" Margin="0" Checked="Source_Checked"/>
            </StackPanel>
        </Grid>

        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="Query" Tag="搜索（支持常见中文名，如：钠、机械动力、JEI）" KeyDown="Query_KeyDown"/>
            <Button Grid.Column="1" Content="搜索" Style="{StaticResource Primary}" Margin="8,0,0,0" Click="Search_Click"/>
        </Grid>

        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" Margin="0,0,14,6">
                <TextBlock Text="版本" Style="{StaticResource Sub}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="GameVersion" Width="120" SelectionChanged="Filter_Changed"/>
            </StackPanel>
            <StackPanel x:Name="LoaderPanel" Orientation="Horizontal" Margin="0,0,14,6">
                <TextBlock Text="加载器" Style="{StaticResource Sub}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="Loader" Width="110" SelectionChanged="Filter_Changed">
                    <ComboBoxItem Content="全部" Tag=""/>
                    <ComboBoxItem Content="Fabric" Tag="fabric"/>
                    <ComboBoxItem Content="Forge" Tag="forge"/>
                    <ComboBoxItem Content="NeoForge" Tag="neoforge"/>
                    <ComboBoxItem Content="Quilt" Tag="quilt"/>
                </ComboBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,14,6">
                <TextBlock Text="排序" Style="{StaticResource Sub}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="Sort" Width="110" SelectionChanged="Filter_Changed">
                    <ComboBoxItem Content="相关度" Tag="relevance"/>
                    <ComboBoxItem Content="下载量" Tag="downloads"/>
                    <ComboBoxItem Content="最近更新" Tag="updated"/>
                    <ComboBoxItem Content="最新发布" Tag="newest"/>
                </ComboBox>
            </StackPanel>
            <StackPanel x:Name="TargetPanel" Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="安装到" Style="{StaticResource Sub}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="Target" Width="200" SelectionChanged="Target_Changed"/>
            </StackPanel>
        </WrapPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ListBox x:Name="Results" Grid.Row="0" Style="{StaticResource CardList}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel"
                     ScrollViewer.ScrollChanged="Results_ScrollChanged" MouseUp="Results_MouseUp">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="46" Height="46" CornerRadius="9" Background="{DynamicResource AccentSoft}" Margin="0,0,12,0" ClipToBounds="True" VerticalAlignment="Top">
                                <Image ui:RemoteImage.Url="{Binding IconUrl}" Stretch="UniformToFill"/>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                    <Border Grid.Column="1" CornerRadius="4" Padding="6,0" Margin="8,1,0,0" VerticalAlignment="Center"
                                            Visibility="{Binding ShowInstalled, Converter={StaticResource BoolVisInstalled}}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource OkSoft}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ShowInstalledOld}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource WarnSoft}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding InstalledText}" FontSize="11">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource Ok}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ShowInstalledOld}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource Warn}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{Binding Author}" Style="{StaticResource Sub}" Margin="8,2,0,0"/>
                                </Grid>
                                <TextBlock Text="{Binding Description}" Style="{StaticResource Sub}" Foreground="{DynamicResource Text2}" TextTrimming="CharacterEllipsis" MaxHeight="34" Margin="0,2,0,3"/>
                                <TextBlock Style="{StaticResource Sub}">
                                    <Run Text="{Binding SourceText, Mode=OneWay}"/>
                                    <Run Text=" · 下载 "/>
                                    <Run Text="{Binding DownloadsText, Mode=OneWay}"/>
                                    <Run Text=" · 更新于 "/>
                                    <Run Text="{Binding Updated, Mode=OneWay, StringFormat=yyyy-MM-dd}"/>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel x:Name="MorePanel" Grid.Row="1" HorizontalAlignment="Center" Margin="0,8,0,4" Visibility="Collapsed">
                <TextBlock x:Name="MoreText" Style="{StaticResource Sub}" HorizontalAlignment="Center"/>
                <!-- 自己画的滑动条：不用 ProgressBar 模板里的不确定态动画，避免出现“只有一条空条” -->
                <Border x:Name="MoreTrack" Width="140" Height="4" CornerRadius="2" Margin="0,5,0,0"
                        Background="{DynamicResource AccentSoft}" ClipToBounds="True" Visibility="Collapsed">
                    <Border x:Name="MoreSweep" Width="48" HorizontalAlignment="Left" CornerRadius="2"
                            Background="{DynamicResource Accent}" Opacity="0.9">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="MoreSweepShift" X="-48"/>
                        </Border.RenderTransform>
                    </Border>
                </Border>
            </StackPanel>
            <StackPanel x:Name="StatusPanel" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock x:Name="StatusText" Style="{StaticResource Body}" HorizontalAlignment="Center" TextAlignment="Center"/>
                <ProgressBar x:Name="StatusBar" IsIndeterminate="True" Width="200" Margin="0,10,0,0"/>
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>
