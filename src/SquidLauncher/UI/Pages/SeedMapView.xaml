<UserControl x:Class="SquidLauncher.UI.Pages.SeedMapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 控制面板。
             这里**故意不用**外层 ScrollViewer：结构列表是个嵌套滚动区，而 WPF 的
             ScrollViewer 用 handledEventsToo 注册了滚轮类处理器，会无视 e.Handled，
             所以只要嵌套就必然「滚内层、外层跟着滚」，挂 handler 也拦不住。
             改成 Grid 分行后，结构列表那一行是唯一可滚动的区域，从结构上不可能冲突。 -->
        <Border x:Name="SidePanel" Grid.Column="0" Width="256" Background="{DynamicResource Card}"
                BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
            <Grid x:Name="SideGrid" Margin="14,14,14,14">
                <!-- 行数必须和下面的子元素一一对应（0..6 共 7 行）。以前多留了一行 Auto，
                     结构列表就落进 Auto 行里、按内容撑到 380px 高，把「重新生成 / 回到原点」
                     一路顶到窗口外面去；星号行反而空着。 -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- 种子 -->
                    <RowDefinition Height="Auto"/>
                    <!-- 游戏版本 + 维度并排 -->
                    <RowDefinition Height="Auto"/>
                    <!-- 前往坐标 -->
                    <RowDefinition Height="Auto"/>
                    <!-- 结构筛选标题 -->
                    <RowDefinition Height="Auto"/>
                    <!-- 结构列表：占满剩余高度，是左栏唯一的滚动区 -->
                    <RowDefinition Height="*" MinHeight="72"/>
                    <!-- 按钮 -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="种子地图" Style="{StaticResource H2}" Margin="0,0,0,2"/>
                    <TextBlock x:Name="HeaderSub" Text="离线和游戏一致的群系预测" Style="{StaticResource Sub}" Margin="0,0,0,8"/>
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <TextBlock Text="种子" Style="{StaticResource Sub}" Margin="0,0,0,4"/>
                    <!-- 提示放在悬停里：常驻那一行会白吃掉两列结构列表需要的高度 -->
                    <TextBox x:Name="SeedBox" Text="0" Margin="0,0,0,8"
                             ToolTip="支持数字或文本（文本按 Java 字符串哈希转换）"/>
                </StackPanel>

                <!-- 版本和维度并排：竖着排要多占约 60px，620 高的窗口就不够放 19 个结构了 -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.45*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="游戏版本" Style="{StaticResource Sub}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="VersionBox" Margin="0,0,0,8"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="维度" Style="{StaticResource Sub}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="DimBox" Margin="0,0,0,8">
                            <ComboBoxItem Content="主世界" IsSelected="True"/>
                            <ComboBoxItem Content="下界"/>
                            <ComboBoxItem Content="末地"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <!-- 前往坐标：X/Z 两个数即可；贴 F3 里的「100 64 200」也能用（中间的 Y 自动忽略） -->
                <DockPanel Grid.Row="3" Margin="0,0,0,6">
                    <TextBlock Text="坐标" Style="{StaticResource Sub}" VerticalAlignment="Center"
                               Margin="0,0,6,0"/>
                    <Button Content="前往" Click="Goto_Click" DockPanel.Dock="Right"
                            Padding="10,4" Margin="6,0,0,0"/>
                    <TextBox x:Name="GotoBox" Padding="6,3" VerticalContentAlignment="Center"
                             KeyDown="GotoBox_KeyDown"
                             ToolTip="输入后回车即可跳转：100 200 / 100,200 / 100 64 200 都可以"/>
                </DockPanel>

                <!-- 结构筛选：勾上的才会在地图上标出来 -->
                <DockPanel Grid.Row="4" Margin="0,0,0,4">
                    <CheckBox x:Name="StructAll" Content="结构标记" DockPanel.Dock="Right"
                              VerticalAlignment="Center" Click="StructAll_Click"
                              Foreground="{DynamicResource Text}"/>
                    <TextBlock Text="结构" Style="{StaticResource Sub}" VerticalAlignment="Center"/>
                </DockPanel>

                <Border Grid.Row="5" Background="{DynamicResource LogBg}" CornerRadius="6" Padding="8,7" Margin="0,0,0,10">
                    <!-- 两列排列：主世界 19 个结构，单列每行 20px 要 380px，620 高的窗口
                         根本放不下（会被星星号行压缩、只能滚动）。两列 10 行只要 200px，
                         默认窗口尺寸就能一眼看全；行高和列宽对齐，不会参差不齐。
                         高度由所在 Grid 行给，这是整个左栏唯一的滚动区（窗口再矮才滚）。 -->
                    <ScrollViewer x:Name="StructScroll" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <!-- 顶部对齐：UniformGrid 默认会把行摊满整个高度，下界只有 3 项时
                             两个格子会被拉成 100 多像素高，项与项之间空出老大一截 -->
                        <UniformGrid x:Name="StructList" Columns="2" VerticalAlignment="Top"/>
                    </ScrollViewer>
                </Border>

                <!-- 两个按钮并排：竖着排要多占 36px -->
                <UniformGrid Grid.Row="6" Columns="2" Margin="0,0,0,2">
                    <Button Content="重新生成" Click="Render_Click" Margin="0,0,3,0" HorizontalAlignment="Stretch"/>
                    <Button Content="回到原点" Click="Home_Click" Margin="3,0,0,0" HorizontalAlignment="Stretch"/>
                </UniformGrid>
            </Grid>
        </Border>

        <!-- 地图画布：一张图由很多 256×256 的瓦片拼成，算好一块淡入一块 -->
        <Grid x:Name="MapHost" Grid.Column="1" Background="{DynamicResource LogBg}" ClipToBounds="True">
            <Canvas x:Name="MapCanvas" ClipToBounds="True" IsHitTestVisible="False"
                    RenderOptions.BitmapScalingMode="NearestNeighbor"/>
            <!-- 结构标记：不参与命中测试，点击由 MapHost 自己按坐标判定 -->
            <Canvas x:Name="MarkerCanvas" ClipToBounds="True" IsHitTestVisible="False">
                <!--
                    跳转标记：点「前往」后标出目标点。

                    挂在 MarkerCanvas 里而不是自己开一层——结构标记只删自己那些子元素，
                    所以结构扫描刷新不会把它一起清掉。

                    形状就是地图上常见的那种图钉（水滴 + 白心），**固定像素尺寸**：
                    它只跟着 Canvas.SetLeft/Top 平移，不做任何缩放，所以地图放大缩小时
                    它大小始终不变，尖端一直指着目标点。

                    配色固定（红身 + 白描边 + 白心）不走主题画刷：群系底色从浅黄沙漠到
                    深蓝深海都有，白色描边保证在哪种底色上都能分开。
                -->
                <Canvas x:Name="JumpMark" Width="0" Height="0" Visibility="Collapsed"
                        Panel.ZIndex="100" IsHitTestVisible="False">
                    <!--
                        拼法说明（几何都手算过，别乱调）：
                        · 尖角 = 12×12 方块绕自身中心转 45° → 对角线半长 8.49，
                          中心放 (0,-8.5)，底尖正好落在 (0,0) 即目标点。
                        · 圆头 = 直径 20，中心 (0,-17)（-8.5 再上移半个对角线 8.49）。
                        · 白心 = 直径 6.8，同圆心。
                        全部用 Ellipse/Rectangle 而不是 Path：Path 在 Stretch=None 时
                        会按 geometry 的 Bounds 产生偏移，位置算不准；Ellipse 的
                        Canvas.Left/Top 就是精确的包围盒左上角。
                        尖角先画（在底层），圆头盖住它的上半部，轮廓自然连贯。
                    -->
                    <Rectangle Canvas.Left="-6" Canvas.Top="-14.5" Width="12" Height="12"
                               Fill="#FFE53935" Stroke="#FFFFFFFF" StrokeThickness="1.6"
                               RenderTransformOrigin="0.5,0.5">
                        <Rectangle.RenderTransform>
                            <RotateTransform Angle="45"/>
                        </Rectangle.RenderTransform>
                    </Rectangle>
                    <Ellipse Canvas.Left="-10" Canvas.Top="-27" Width="20" Height="20"
                             Fill="#FFE53935" Stroke="#FFFFFFFF" StrokeThickness="1.6"/>
                    <Ellipse Canvas.Left="-3.4" Canvas.Top="-20.4" Width="6.8" Height="6.8"
                             Fill="#FFFFFFFF"/>
                </Canvas>
            </Canvas>
            <!-- 底部状态条：坐标 / 群系 / 缩放比例 / 引擎状态。放在地图这边而不是左栏，
                 是为了把左栏的高度全部让给结构列表（否则列表只剩几十像素）。
                 不参与命中测试，不影响地图拖动。 -->
            <Border VerticalAlignment="Bottom" Background="{DynamicResource Card}" Opacity="0.94"
                    BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="10,6"
                    IsHitTestVisible="False">
                <DockPanel LastChildFill="True">
                    <TextBlock x:Name="PosText" Text="—" FontFamily="Consolas" FontSize="12"
                               DockPanel.Dock="Left" Margin="0,0,14,0"
                               Foreground="{DynamicResource Text}"/>
                    <!-- 缩放比例：只读显示，缩放靠滚轮 -->
                    <TextBlock x:Name="ZoomText" Text="1 : 16" FontFamily="Consolas" FontSize="12"
                               DockPanel.Dock="Right" Margin="14,0,0,0"
                               Foreground="{DynamicResource Text}" ToolTip="滚轮缩放"/>
                    <TextBlock x:Name="EngineState" Style="{StaticResource Sub}" FontSize="11"
                               DockPanel.Dock="Right" Margin="14,0,0,0" TextWrapping="NoWrap"
                               Visibility="Collapsed"/>
                    <TextBlock x:Name="BiomeText" Text="把鼠标移到地图上查看群系" Style="{StaticResource Sub}"
                               FontSize="11" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>
            <!-- 结构详情卡片 -->
            <Canvas x:Name="CardLayer" ClipToBounds="True">
                <Border x:Name="StructCard" Visibility="Collapsed" Background="{DynamicResource Card}"
                        BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8"
                        Padding="14,12" Width="248">
                    <StackPanel>
                        <DockPanel>
                            <Border x:Name="CardSwatch" Width="10" Height="10" CornerRadius="2"
                                    DockPanel.Dock="Left" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="CardTitle" Style="{StaticResource H2}" Text="结构"/>
                            <Button Content="&#xE711;" FontFamily="Segoe MDL2 Assets" DockPanel.Dock="Right"
                                    HorizontalAlignment="Right" Padding="4,0" MinWidth="0" BorderThickness="0"
                                    Background="Transparent" Click="CardClose_Click" ToolTip="关闭"/>
                        </DockPanel>
                        <TextBlock x:Name="CardSub" Style="{StaticResource Sub}" FontSize="11"
                                   TextWrapping="Wrap" Margin="0,2,0,0"/>
                        <Border Background="{DynamicResource LogBg}" CornerRadius="6" Padding="9,7" Margin="0,9,0,0">
                            <StackPanel>
                                <TextBlock x:Name="CardCoord" FontFamily="Consolas" FontSize="12"
                                           Foreground="{DynamicResource Text}"/>
                                <TextBlock x:Name="CardMeta" Style="{StaticResource Sub}" FontSize="11"
                                           TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                        <WrapPanel Margin="0,10,0,0">
                            <Button Content="复制指令" Click="CardCopy_Click" Margin="0,0,6,6"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Canvas>
            <Border x:Name="NoticePanel" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}"
                    BorderThickness="1" CornerRadius="8"
                    Padding="20,16" MaxWidth="460" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="NoticeTitle" Style="{StaticResource H2}" Text="正在准备生成引擎"/>
                    <TextBlock x:Name="NoticeBody" Style="{StaticResource Body}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    <ProgressBar x:Name="NoticeProgress" Height="6" Margin="0,14,0,0"
                                 Minimum="0" Maximum="1" Visibility="Collapsed"/>
                    <TextBlock x:Name="NoticeStatus" Style="{StaticResource Sub}" FontSize="11"
                               Margin="0,6,0,0" TextWrapping="Wrap"/>
                    <WrapPanel x:Name="NoticeActions" Margin="0,12,0,0" Visibility="Collapsed">
                        <!-- 点了只会弹「你想怎么处理」，不会自己下载 -->
                        <Button x:Name="RetryBtn" Content="选择引擎…" Click="Retry_Click" Margin="0,0,8,6"/>
                        <Button Content="打开工具目录" Click="OpenTools_Click" Margin="0,0,8,6"/>
                        <Button Content="了解原理" Click="Explain_Click" Margin="0,0,8,6"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
            <!-- 结构统计放地图右上角：底部留给状态条，左栏留给结构列表。
                 用和底部状态条一样的卡片底（ScrimSoft 半透明太淡，压在亮色群系上根本看不清）。
                 不参与命中测试，挡住的地方照样能拖动地图。 -->
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0"
                        IsHitTestVisible="False">
                <Border x:Name="StructHintBox" Background="{DynamicResource Card}" Opacity="0.94"
                        CornerRadius="6" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                        Padding="9,4" HorizontalAlignment="Right" Visibility="Collapsed">
                    <TextBlock x:Name="StructHint" Style="{StaticResource Sub}" FontSize="11"
                               TextWrapping="Wrap" MaxWidth="320" TextAlignment="Right"/>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
