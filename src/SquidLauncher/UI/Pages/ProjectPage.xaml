<UserControl x:Class="SquidLauncher.UI.Pages.ProjectPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:SquidLauncher.UI">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisFile"/>
    </UserControl.Resources>
    <DockPanel Margin="22,16,22,10">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Style="{StaticResource Ghost}" Click="Back_Click" Margin="-8,0,6,0">
                <TextBlock Text="&#xE72B;" Style="{StaticResource Icon}"/>
            </Button>
            <TextBlock Text="资源详情" Style="{StaticResource H1}" VerticalAlignment="Center"/>
        </StackPanel>

        <Border DockPanel.Dock="Top" Style="{StaticResource CardBox}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="64" Height="64" CornerRadius="12" Background="{DynamicResource AccentSoft}" Margin="0,0,16,0" ClipToBounds="True" VerticalAlignment="Top">
                    <Image x:Name="Icon" Stretch="UniformToFill"/>
                </Border>
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="PTitle" Style="{StaticResource H1}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="PMeta" Style="{StaticResource Sub}" Margin="0,3,0,6"/>
                    <TextBlock x:Name="PDesc" Style="{StaticResource Body}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Top" Margin="12,0,0,0">
                    <Button Content="打开网页" Click="Web_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="DepPanel" DockPanel.Dock="Top" Style="{StaticResource CardBox}" Visibility="Collapsed" Margin="0,0,0,8">
            <StackPanel>
                <DockPanel LastChildFill="False">
                    <TextBlock x:Name="DepTitle" Text="前置 Mod" Style="{StaticResource H2}" Margin="0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="DepHint" Style="{StaticResource Sub}" VerticalAlignment="Center" Margin="10,2,0,0"/>
                </DockPanel>
                <ScrollViewer MaxHeight="168" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,8,0,0">
                    <ItemsControl x:Name="DepList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="8" Padding="8,9" Margin="0,0,0,2" Cursor="Hand" Focusable="True"
                                        MouseLeftButtonUp="DepRow_Click" KeyDown="DepRow_KeyDown">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34" CornerRadius="8" Background="{DynamicResource AccentSoft}" ClipToBounds="True" VerticalAlignment="Center">
                                            <Image ui:RemoteImage.Url="{Binding IconUrl}" Stretch="UniformToFill"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,4,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Text}"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="360" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Note}" Style="{StaticResource Sub}" FontSize="11" Margin="8,1,0,0" VerticalAlignment="Center"
                                                           Visibility="{Binding ShowNote, Converter={StaticResource BoolVisFile}}"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Desc}" Style="{StaticResource Sub}" FontSize="11.5" Margin="0,1,0,0"
                                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                                       Visibility="{Binding ShowDesc, Converter={StaticResource BoolVisFile}}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock x:Name="FilesTitle" Text="选择要下载的文件" Style="{StaticResource H2}" VerticalAlignment="Center" Margin="0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <CheckBox x:Name="OnlyMatch" Style="{StaticResource Switch}" Content="只看适配当前筛选的" IsChecked="True" Click="OnlyMatch_Click" Margin="0,0,12,0"/>
                <TextBlock x:Name="TargetInfo" Style="{StaticResource Sub}" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <Grid>
            <ListBox x:Name="Files" Style="{StaticResource CardList}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel"
                     SelectionChanged="Files_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="420"/>
                                    <Border Background="{DynamicResource AccentSoft}" CornerRadius="4" Padding="5,0" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding ReleaseTypeText}" FontSize="11" Foreground="{DynamicResource Accent}"/>
                                    </Border>
                                    <Border Background="{DynamicResource OkSoft}" CornerRadius="4" Padding="5,0" Margin="8,0,0,0"
                                            Visibility="{Binding IsInstalled, Converter={StaticResource BoolVisFile}}" ToolTip="这个版本已经装在目标版本里了">
                                        <TextBlock Text="已安装" FontSize="11" Foreground="{DynamicResource Ok}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Style="{StaticResource Sub}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                                    <Run Text="{Binding GameVersionsText, Mode=OneWay}"/>
                                    <Run Text=" · "/>
                                    <Run Text="{Binding LoadersText, Mode=OneWay}"/>
                                    <Run Text=" · "/>
                                    <Run Text="{Binding Published, Mode=OneWay, StringFormat=yyyy-MM-dd}"/>
                                    <Run Text=" · "/>
                                    <Run Text="{Binding SizeText, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                            <!-- 一个整体：左边下载，右边下拉箭头，中间一条竖线隔开 -->
                            <Border Grid.Column="1" Background="{DynamicResource Accent}" CornerRadius="7" Height="30" VerticalAlignment="Center">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="1"/>
                                        <ColumnDefinition Width="30"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="下载" Style="{StaticResource SplitLeft}" Click="Download_Click"/>
                                    <Border Grid.Column="1" Background="#4DFFFFFF" Margin="0,6"/>
                                    <!-- 下载旁边的下拉：目前只放「另存为」（不装进版本，直接存到磁盘） -->
                                    <Button Grid.Column="2" Style="{StaticResource SplitRight}"
                                            Click="DownloadMenu_Click" PreviewMouseLeftButtonDown="DownloadMenu_PreviewMouseDown"
                                            ToolTip="更多下载方式">
                                        <!-- 箭头：菜单打开时绕自己中心转到朝上（模板里的变换是冻结的，动画在代码里现建一个） -->
                                        <TextBlock Text="&#xE70D;" FontFamily="{StaticResource Icons}" FontSize="10"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                            <TextBlock.RenderTransform>
                                                <RotateTransform Angle="0"/>
                                            </TextBlock.RenderTransform>
                                        </TextBlock>
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="另存为…" Click="SaveAs_Click"/>
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel x:Name="StatusPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="StatusText" Text="加载文件列表…" Style="{StaticResource Body}" HorizontalAlignment="Center" TextAlignment="Center"/>
                <ProgressBar x:Name="StatusBar" IsIndeterminate="True" Width="200" Margin="0,10,0,0"/>
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>
