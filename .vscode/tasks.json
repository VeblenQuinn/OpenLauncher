{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "编译发布版（dist）",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}\\build.ps1"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": []
		},
		{
			"label": "调试编译",
			"type": "shell",
			"command": "dotnet",
			"args": [
				"build",
				"${workspaceFolder}\\src\\OpenLauncher\\OpenLauncher.csproj",
				"-c",
				"Debug",
				"-nologo"
			],
			"problemMatcher": "$msCompile"
		},
		{
			"label": "编译发布工具 ol-release",
			"type": "shell",
			"command": "dotnet",
			"args": [
				"build",
				"${workspaceFolder}\\tools\\Release\\OpenLauncher.Release.csproj",
				"-c",
				"Release",
				"-nologo"
			],
			"problemMatcher": "$msCompile"
		}
	]
}